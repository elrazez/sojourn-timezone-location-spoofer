{
  "manifest_version": 3,
  "name": "Sojourn",
  "version": "0.1.1",
  "description": "Websites see the geolocation and time zone of a city you pick, and nothing else changes.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "storage"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sojourn",
    "default_popup": "popup.html"
  }
}
